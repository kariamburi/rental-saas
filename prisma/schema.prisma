generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  properties          Property[]
  units               Unit[]
  tenants             Tenant[]
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]
  maintenanceRequests MaintenanceRequest[]
  meterReadings       MeterReading[]
  unitBookings        UnitBooking[]
  owners              Owner[]
  propertyOwnerships  PropertyOwnership[]
  ownerPayouts        OwnerPayout[]
  propertyInspections PropertyInspection[]
}

model User {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  email     String   @unique
  password  String
  role      String   @default("COMPANY_ADMIN")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  units               Unit[]
  expenses            Expense[]
  maintenanceRequests MaintenanceRequest[]
  unitBookings        UnitBooking[]
  ownerships          PropertyOwnership[]
  inspections         PropertyInspection[]
}

model Unit {
  id         String   @id @default(cuid())
  companyId  String
  propertyId String
  unitNumber String
  rentAmount Decimal  @db.Decimal(12, 2)
  status     String   @default("VACANT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  tenants             Tenant[]
  leases              Lease[]
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  meterReadings       MeterReading[]
  unitBookings        UnitBooking[]
  inspections         PropertyInspection[]
}

model Lease {
  id             String  @id @default(cuid())
  companyId      String
  tenantId       String
  unitId         String
  monthlyRent    Decimal @db.Decimal(12, 2)
  depositAmount  Decimal @default(0) @db.Decimal(12, 2)
  garbageCharge  Decimal @default(0) @db.Decimal(12, 2)
  securityCharge Decimal @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal @default(0) @db.Decimal(12, 2)

  startDate       DateTime
  endDate         DateTime?
  billingDay      Int       @default(1)
  rentDueDay      Int       @default(5)
  gracePeriodDays Int       @default(0)
  notes           String?

  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company @relation(fields: [companyId], references: [id])
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  unit           Unit    @relation(fields: [unitId], references: [id])
  agreementTerms String?
}

model MeterReading {
  id              String   @id @default(cuid())
  companyId       String
  tenantId        String
  unitId          String
  type            String // WATER or ELECTRICITY
  previousReading Decimal  @db.Decimal(12, 2)
  currentReading  Decimal  @db.Decimal(12, 2)
  unitsUsed       Decimal  @db.Decimal(12, 2)
  ratePerUnit     Decimal  @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  billingMonth    String // 2026-06
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  companyId   String
  tenantId    String
  unitId      String
  invoiceNo   String   @unique
  invoiceDate DateTime @default(now())
  dueDate     DateTime
  amount      Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)
  balance     Decimal  @db.Decimal(12, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id])
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  unit     Unit          @relation(fields: [unitId], references: [id])
  payments Payment[]
  items    InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  type        String  @default("RENT")
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String
  tenantId    String
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  reference   String?
  paymentDate DateTime @default(now())
  receivedBy  String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  propertyId  String
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  companyId   String
  tenantId    String?
  propertyId  String
  unitId      String?
  title       String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])
}

model Tenant {
  id               String    @id @default(cuid())
  companyId        String
  unitId           String?
  name             String
  phone            String
  email            String?
  idNumber         String?
  occupation       String?
  emergencyContact String?
  moveInDate       DateTime?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  unit                Unit?                @relation(fields: [unitId], references: [id])
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  meterReadings       MeterReading[]
  inspections         PropertyInspection[]
}

model UnitBooking {
  id             String    @id @default(cuid())
  companyId      String
  propertyId     String
  unitId         String
  customerName   String
  phone          String
  email          String?
  idNumber       String?
  bookingDate    DateTime  @default(now())
  expectedMoveIn DateTime?
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("PENDING")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
}

model Owner {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String
  email     String?
  idNumber  String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company             @relation(fields: [companyId], references: [id])
  properties PropertyOwnership[]
  payouts    OwnerPayout[]
}

model PropertyOwnership {
  id         String   @id @default(cuid())
  companyId  String
  ownerId    String
  propertyId String
  percentage Decimal  @default(100) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  owner    Owner    @relation(fields: [ownerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
}

model OwnerPayout {
  id         String   @id @default(cuid())
  companyId  String
  ownerId    String
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  reference  String?
  payoutDate DateTime @default(now())
  notes      String?
  paidBy     String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  owner   Owner   @relation(fields: [ownerId], references: [id])
}

model PropertyInspection {
  id             String   @id @default(cuid())
  companyId      String
  propertyId     String
  unitId         String?
  tenantId       String?
  inspectionDate DateTime @default(now())
  type           String   @default("ROUTINE")
  status         String   @default("PENDING")
  overallNotes   String?
  inspectedBy    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company                  @relation(fields: [companyId], references: [id])
  property Property                 @relation(fields: [propertyId], references: [id])
  unit     Unit?                    @relation(fields: [unitId], references: [id])
  tenant   Tenant?                  @relation(fields: [tenantId], references: [id])
  items    PropertyInspectionItem[]
}

model PropertyInspectionItem {
  id           String   @id @default(cuid())
  inspectionId String
  area         String
  condition    String
  notes        String?
  photoUrl     String?
  createdAt    DateTime @default(now())

  inspection PropertyInspection @relation(fields: [inspectionId], references: [id])
}
